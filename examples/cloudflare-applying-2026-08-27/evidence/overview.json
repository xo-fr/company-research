   "entity_id": "us:0001477333",
   "claims": [
    {
     "id": "overview.0",
     "text": "Cloudflare sells network, security and developer-platform services from its own global edge, positioning itself against on-premises hardware vendors and the hyperscalers' equivalents (10-K Item 1, Business).",
     "source_ids": [
      "s1"
     ],
     "confidence": "high",
     "as_of": "2026-02-26"
    },
    {
     "id": "overview.1",
     "text": "Revenue reached $2.17bn in FY2025, up 29.9% year on year and compounding at 38% since FY2020 ($431m).",
     "source_ids": [
      "s1"
     ],
     "confidence": "high",
     "as_of": "2025-12-31"
    },
    {
     "id": "overview.2",
     "text": "The company has never been profitable on a GAAP basis: operating loss was $207m in FY2025, wider than FY2024's $155m, and it names its history of net losses as its first enumerated risk factor.",
     "source_ids": [
      "s1"
     ],
     "confidence": "high",
     "as_of": "2025-12-31"
    },
    {
     "id": "overview.3",
     "text": "R&D spend rose every year from $127m (FY2020) to $512m (FY2025), roughly 24% of revenue — an engineering-heavy cost base, which is where a systems role sits.",
     "source_ids": [
      "s1"
     ],
     "confidence": "high",
     "as_of": "2025-12-31"
    },
    {
     "id": "overview.4",
     "text": "Headcount was 5,156 full-time employees at 31 December 2025, of whom 2,452 were outside the United States (10-K, Human Capital Resources).",
     "source_ids": [
      "s1"
     ],
     "confidence": "high",
     "as_of": "2025-12-31"
    }
   ],
   "gaps": []
  }
 }
